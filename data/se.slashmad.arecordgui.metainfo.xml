  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>slashmad arecord GUI</name>
  <summary>Record audio through direct ALSA hardware devices</summary>
  <description>
    <p>
      This GTK4 frontend records uncompressed audio with arecord through an
      explicitly selected ALSA hardware PCM.
    </p>
    <p>
      It keeps BlackmagicIO as the default device and records stereo audio at
      48 kHz in the S32_LE format without routing capture through an audio
      server.
    </p>
  </description>
  <launchable type="desktop-id">se.slashmad.arecordgui.desktop</launchable>
